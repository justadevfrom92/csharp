<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Roadmap.PreciseUtilities</RootNamespace>
    <!-- NuGet package metadata -->
    <PackageId>Roadmap.PreciseUtilities</PackageId>
    <Version>1.0.0</Version>
    <Authors>CSharpMasteryRoadmap</Authors>
    <Description>Precisely named text, validation and argument-guard helpers.</Description>
    <PackageTags>validation;text;slug;guards</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>PACKAGE_README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- dotnet pack writes straight into the local feed the consumer restores from. -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)../LocalNuGetFeed</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Include="PACKAGE_README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
