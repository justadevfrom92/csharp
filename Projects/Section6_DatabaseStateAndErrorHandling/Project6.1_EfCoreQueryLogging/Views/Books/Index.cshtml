@model List<Book>
<!DOCTYPE html>
<html>
<head><meta charset="utf-8" /><title>Library</title></head>
<body style="font-family: sans-serif; padding: 16px;">
    <h1>Books</h1>
    <p>Watch the console: every SQL query EF runs is logged there and in <code>logs/</code>.</p>
    <ul>
        @foreach (Book book in Model)
        {
            <li>
                <b>@book.Title</b> (@book.PublishedYear) by @book.Author.Name
                @if (book.Author.Profile != null)
                {
                    <i>- @book.Author.Profile.Biography</i>
                }
                [@string.Join(", ", book.Tags.Select(tag => tag.Name))]
            </li>
        }
    </ul>

    <h2>Add book</h2>
    <form asp-action="Create" method="post">
        <input name="title" placeholder="Title" required />
        <input name="publishedYear" type="number" value="2026" />
        <input name="authorName" placeholder="Author" required />
        @foreach (Tag tag in ViewBag.Tags)
        {
            <label><input type="checkbox" name="tagIds" value="@tag.Id" /> @tag.Name</label>
        }
        <button type="submit">Add</button>
    </form>
</body>
</html>
