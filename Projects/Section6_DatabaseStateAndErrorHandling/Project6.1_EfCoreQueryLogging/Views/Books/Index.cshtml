@*
    @model BookLibraryViewModel (Models/BookLibraryViewModel.cs) = the books to show + the "Add book" form fields.
    New to .cshtml? See Projects/RAZOR_BASICS.md.
*@
@model BookLibraryViewModel
<!DOCTYPE html>
<html>
<head><meta charset="utf-8" /><title>Library</title></head>
<body style="font-family: sans-serif; padding: 16px;">
    <h1>Books</h1>
    <p>Watch the console: every SQL query EF runs is logged there and in <code>logs/</code>.</p>
    <ul>
        @foreach (Book book in Model.Books)
        {
            <li>
                <b>@book.Title</b> (@book.PublishedYear) by @book.Author.Name
                @if (book.Author.Profile != null)
                {
                    <i>- @book.Author.Profile.Biography</i>
                }
                [@string.Join(", ", book.Tags.Select(tag => tag.Name))]
            </li>
        }
    </ul>

    <h2>Add book</h2>
    @*
        asp-action="Create" + method="post" -> action="/Books/Create" + a hidden anti-forgery token
        (checked by [ValidateAntiForgeryToken] on Create).
        asp-for="Title" -> name="Title", the current value, and maxlength from [StringLength] on the view model.
        On POST, model binding fills BookLibraryViewModel.Title etc. from those names.
        asp-validation-for shows the message from [Required]/[Range] when the form comes back with errors.
    *@
    <form asp-action="Create" method="post">
        <input asp-for="Title" placeholder="Title" /> <span asp-validation-for="Title" style="color: #b00020"></span>
        <input asp-for="PublishedYear" /> <span asp-validation-for="PublishedYear" style="color: #b00020"></span>
        <input asp-for="AuthorName" placeholder="Author" /> <span asp-validation-for="AuthorName" style="color: #b00020"></span>
        @*
            Checkboxes for an int[] can't use asp-for (it only handles a single bool per checkbox),
            so we write name="SelectedTagIds" by hand. It must match the view model property name.
            Every ticked box sends SelectedTagIds=<id>; model binding collects them into the array.
        *@
        @foreach (Tag tag in Model.AllTags)
        {
            <label><input type="checkbox" name="SelectedTagIds" value="@tag.Id" checked="@Model.SelectedTagIds.Contains(tag.Id)" /> @tag.Name</label>
        }
        <button type="submit">Add</button>
    </form>
</body>
</html>
