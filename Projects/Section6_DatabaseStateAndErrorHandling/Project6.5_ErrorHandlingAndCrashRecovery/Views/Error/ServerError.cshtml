@* @model ServerErrorViewModel (Models/ServerErrorViewModel.cs) = just the error id. *@
@model ServerErrorViewModel

<h1>Sorry, something went wrong.</h1>
<p>We've been notified and are looking into it. Please try again in a minute.</p>
<p>If you contact support, quote this error id: <code id="error-id">@Model.ErrorId</code></p>
