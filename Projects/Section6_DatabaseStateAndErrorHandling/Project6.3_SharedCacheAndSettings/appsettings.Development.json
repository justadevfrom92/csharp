{
  // Loaded ON TOP OF appsettings.json, only when ASPNETCORE_ENVIRONMENT=Development.
  // Only the values written here change; everything else still comes from appsettings.json.
  // In development we want to see more: "Information" for ASP.NET Core logs every request
  // (which endpoint ran, status code, how long it took). appsettings.json keeps it at "Warning".
  "Logging": {
    "LogLevel": {
      "Microsoft.AspNetCore": "Information"
    }
  }
}
