<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.85.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Grpc.Tools turns the .proto file into C# at build time:
         - the SERVER base class we inherit from (StockService.StockServiceBase),
         - the CLIENT class (StockService.StockServiceClient), used by the test project,
         - the message classes (GetStockRequest, StockReply...).
         A separate client app would instead include the same .proto with GrpcServices="Client". -->
    <Protobuf Include="Protos/stock.proto" GrpcServices="Both" />
  </ItemGroup>
</Project>
