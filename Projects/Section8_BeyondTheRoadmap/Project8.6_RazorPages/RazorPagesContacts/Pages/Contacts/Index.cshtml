@page
@*
    RAZOR PAGES: "@page" makes this file a page with its own URL (/Contacts). Its C# code lives right next to it
    in Index.cshtml.cs (class ContactIndexPageModel). No controller needed.
*@
@model ContactIndexPageModel
@{
    ViewData["Title"] = "Contacts";
}

<h1>Contacts</h1>
<table id="contact-table">
    <tr><th>Name</th><th>Email</th><th>Phone</th><th></th></tr>
    @foreach (ContactModel contact in Model.Contacts)
    {
        <tr>
            <td>@contact.Name</td>
            <td>@contact.Email</td>
            <td>@contact.Phone</td>
            @* asp-route-id fills the {id} in the Edit page's "@page "{id:int}"": href="/Contacts/Edit/1" *@
            <td><a asp-page="/Contacts/Edit" asp-route-id="@contact.Id">Edit</a></td>
        </tr>
    }
</table>
