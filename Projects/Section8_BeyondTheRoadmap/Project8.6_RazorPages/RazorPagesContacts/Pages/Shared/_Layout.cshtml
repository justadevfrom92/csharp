<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Contacts</title>
    <style>
        body { font-family: sans-serif; max-width: 700px; margin: 0 auto; padding: 16px; }
        label { display: block; margin-top: 8px; }
        .error { color: #b00020; }
        .message { background: #e6f4ea; padding: 8px; }
        td, th { border: 1px solid #ccc; padding: 4px 8px; }
        table { border-collapse: collapse; }
    </style>
</head>
<body>
    @* asp-page builds a link to a PAGE (not a controller/action): "/Contacts/Index" -> href="/Contacts" *@
    <nav><a asp-page="/Contacts/Index">All contacts</a> | <a asp-page="/Contacts/Create">Add contact</a></nav>
    @if (TempData["Message"] is string message)
    {
        <p class="message" id="message">@message</p>
    }
    @RenderBody()
</body>
</html>
