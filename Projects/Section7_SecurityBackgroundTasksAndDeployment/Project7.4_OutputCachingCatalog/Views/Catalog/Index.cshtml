@model List<CatalogProduct>
<!DOCTYPE html>
<html>
<head><meta charset="utf-8" /><title>Catalog</title></head>
<body style="font-family: sans-serif; padding: 16px;">
    <h1>Catalog (@(ViewBag.Cached ? "output cached" : "NOT cached"))</h1>
    <p>Page rendered at <b id="rendered-at">@ViewBag.RenderedAt</b> - refresh: on the cached page this time doesn't change.</p>
    <p><a href="/Catalog/Index">Cached</a> | <a href="/Catalog/Uncached">Uncached</a> | <a href="/stats">DB reads</a> | <a href="/health">Health</a></p>

    @* Plain form on purpose: the asp-action tag helper would add an anti-forgery cookie, and responses that set cookies are never output cached.
       A real admin form would live on a separate, uncached page. *@
    <form action="/Catalog/ChangePrice" method="post">
        Product id <input name="productId" value="1" size="3" />
        new price <input name="newPrice" value="99.99" size="6" />
        <button type="submit">Change price (clears cache)</button>
    </form>

    <ul>
        @foreach (CatalogProduct product in Model)
        {
            <li>@product.Name - @product.Price.ToString("0.00")</li>
        }
    </ul>
</body>
</html>
