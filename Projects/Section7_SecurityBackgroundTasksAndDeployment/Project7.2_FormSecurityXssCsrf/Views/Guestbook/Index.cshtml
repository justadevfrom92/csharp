@model GuestbookEntry
@{
    var allEntries = (List<GuestbookEntry>)ViewBag.Entries;
}
<!DOCTYPE html>
<html>
<head><meta charset="utf-8" /><title>Guestbook</title></head>
<body style="font-family: sans-serif; padding: 16px; max-width: 700px;">
    <h1>Guestbook</h1>
    <p>Try posting <code>&lt;script&gt;alert('hacked')&lt;/script&gt;</code> or <code>&lt;b&gt;bold&lt;/b&gt;</code>
       as a message, or <code>javascript:alert(1)</code> as a website.</p>

    @*
        asp-action="Index" + method="post" -> action="/" + a hidden __RequestVerificationToken.
        That token is what the global AutoValidateAntiforgeryToken filter checks: a form on another
        website can't know it, so a forged POST is rejected with 400.
        asp-for="Name" -> id/name="Name", current value (HTML-encoded, so it's safe), and maxlength from [StringLength].
        asp-validation-for shows that field's error message.
        (This is a Razor comment, not an HTML comment: HTML comments are sent to the browser, Razor comments are not.)
    *@
    <form asp-action="Index" method="post">
        <div><input asp-for="Name" placeholder="Name" /> <span asp-validation-for="Name"></span></div>
        <div><textarea asp-for="Message" placeholder="Message"></textarea> <span asp-validation-for="Message"></span></div>
        <div><input asp-for="Website" placeholder="https://..." /> <span asp-validation-for="Website"></span></div>
        <button type="submit">Post</button>
    </form>

    @foreach (GuestbookEntry entry in allEntries)
    {
        <div class="entry" style="border-top: 1px solid #ccc; margin-top: 10px;">
            @* SAFE: @entry.Message is HTML-encoded, so "<script>" is shown as text, not run. *@
            <p><b>@entry.Name</b> wrote: @entry.Message</p>

            @* NEVER do this with user input:  @Html.Raw(entry.Message)  - it would run their script. *@

            @if (entry.Website != null)
            {
                @* Attribute values are encoded too, and the controller only allows http/https links. *@
                <a href="@entry.Website" rel="nofollow noopener">@entry.Website</a>
            }
        </div>
    }
</body>
</html>
