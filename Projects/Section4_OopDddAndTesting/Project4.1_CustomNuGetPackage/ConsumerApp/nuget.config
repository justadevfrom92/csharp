<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Look for packages in our local folder first, then on nuget.org. -->
  <packageSources>
    <add key="LocalFeed" value="../LocalNuGetFeed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
