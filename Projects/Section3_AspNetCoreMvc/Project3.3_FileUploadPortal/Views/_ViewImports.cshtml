@using FileUploadPortal.Models
@*
    Turns on the built-in "asp-*" Tag Helpers for all views. They run on the SERVER and rewrite
    tags into plain HTML (asp-action="Avatar" -> href="/Upload/Avatar"). Without this line the
    asp-* attributes do nothing. Full explanation with examples: Project 3.1 Views.
*@
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
