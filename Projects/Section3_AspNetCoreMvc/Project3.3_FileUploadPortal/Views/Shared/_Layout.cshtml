<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Upload Portal</title>
    <style>
        body { font-family: sans-serif; max-width: 700px; margin: 0 auto; padding: 16px; }
        .error { color: #b00020; display: block; }
        .message { background: #e6f4ea; padding: 8px; }
    </style>
</head>
<body>
    <nav>
        <a asp-action="Index">Files</a> |
        <a asp-action="Avatar">Upload avatar</a> |
        <a asp-action="Document">Upload document</a>
    </nav>
    @if (TempData["Message"] is string message)
    {
        <p class="message">@message</p>
    }
    @RenderBody()
</body>
</html>
