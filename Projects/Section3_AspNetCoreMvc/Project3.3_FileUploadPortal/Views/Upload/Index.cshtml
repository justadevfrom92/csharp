@*
    New to .cshtml? See Projects/RAZOR_BASICS.md.

    @model says what TYPE of data this page receives from the controller.
    UploadController.Index() ends with "return View(savedFileNames);" - that List<string> arrives here as "Model".
*@
@model List<string>

<h2>Uploaded files</h2>
@if (Model.Count == 0)
{
    <p>No files yet.</p>
}
@* "~/" = site root (wwwroot). "~/uploads/abc.png" becomes "/uploads/abc.png", served by UseStaticFiles. *@
<ul>
    @* @foreach is a normal C# loop. Every line of HTML inside it is written once per file name.
       @fileName prints the C# value into the HTML (HTML-encoded, so it's safe). *@
    @foreach (string fileName in Model)
    {
        <li><a href="~/uploads/@fileName">@fileName</a></li>
    }
</ul>
