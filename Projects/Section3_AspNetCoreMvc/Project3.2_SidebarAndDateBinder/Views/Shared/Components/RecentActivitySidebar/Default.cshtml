@model List<ActivityEntryModel>

<h3>Recent activity</h3>
@if (Model.Count == 0)
{
    <p>Nothing yet.</p>
}
<ul>
    @foreach (ActivityEntryModel entry in Model)
    {
        <li>
            <a href="/Activity/Day?day=@entry.Date.ToString("yyyy-MM-dd")">@entry.Date.ToString("yyyy-MM-dd")</a>
            @entry.Time.ToString("HH:mm") - @entry.Text
        </li>
    }
</ul>
