<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Activity</title>
    <style>
        body { font-family: sans-serif; display: flex; gap: 30px; padding: 16px; }
        main { flex: 1; }
        aside { width: 260px; background: #f3f3f3; padding: 10px; }
        .error { color: #b00020; }
    </style>
</head>
<body>
    <main>
        @* asp-action with no asp-controller = an action on the CURRENT controller (Activity here).
           Becomes href="/" and href="/Activity/Day". Built from the routes, so they never go stale. *@
        <a asp-action="Index">Home</a> | <a asp-action="Day">Today's activity</a>
        @RenderBody()
    </main>
    <aside>
        @*
            <vc:...> calls a VIEW COMPONENT. The name is the class name in kebab-case, minus "ViewComponent":
                RecentActivitySidebarViewComponent  ->  <vc:recent-activity-sidebar>
            Each attribute becomes a parameter of InvokeAsync: count="5" -> InvokeAsync(count: 5).
            A misspelled name or parameter is a COMPILE error (unlike the older @await Component.InvokeAsync("...")).
        *@
        <vc:recent-activity-sidebar count="5" />
    </aside>
</body>
</html>
