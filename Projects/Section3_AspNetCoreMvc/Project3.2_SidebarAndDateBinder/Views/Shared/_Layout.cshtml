<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Activity</title>
    <style>
        body { font-family: sans-serif; display: flex; gap: 30px; padding: 16px; }
        main { flex: 1; }
        aside { width: 260px; background: #f3f3f3; padding: 10px; }
        .error { color: #b00020; }
    </style>
</head>
<body>
    <main>
        <a asp-action="Index">Home</a> | <a asp-action="Day">Today's activity</a>
        @RenderBody()
    </main>
    <aside>
        <vc:recent-activity-sidebar count="5" />
    </aside>
</body>
</html>
