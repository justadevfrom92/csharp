@model List<ActivityEntryModel>

<h2>Activity on @(((DateOnly)ViewBag.Day).ToString("dddd d MMMM yyyy"))</h2>
@if (ViewBag.Error != null)
{
    <p class="error">@ViewBag.Error Showing today instead.</p>
}
<ul>
    @foreach (ActivityEntryModel entry in Model)
    {
        <li>@entry.Time.ToString("HH:mm") - @entry.Text</li>
    }
</ul>
