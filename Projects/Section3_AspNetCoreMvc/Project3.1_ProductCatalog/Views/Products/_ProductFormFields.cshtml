@model Product

<div asp-validation-summary="ModelOnly"></div>

<label asp-for="Name"></label>
<input asp-for="Name" />
<span asp-validation-for="Name" class="field-error"></span>

<label asp-for="Category"></label>
<select asp-for="Category" asp-items="@(new SelectList((string[])ViewBag.Categories))">
    <option value="">-- choose --</option>
</select>
<span asp-validation-for="Category" class="field-error"></span>

<label asp-for="Price"></label>
<input asp-for="Price" />
<span asp-validation-for="Price" class="field-error"></span>

<label asp-for="Description"></label>
<textarea asp-for="Description"></textarea>
