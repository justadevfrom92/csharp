@{ ViewData["Title"] = "Home"; }
<h1>Upload portal</h1>
<ul>
    <li><a asp-controller="ProfileAvatar" asp-action="Index">Upload a profile avatar</a>: PNG/JPG/GIF/WebP, max 2 MB.</li>
    <li><a asp-controller="SupportingDocuments" asp-action="Index">Upload supporting documents</a>: PDF/DOCX/XLSX/TXT/CSV, max 5 MB each, up to 5 at once.</li>
</ul>
