@model ProfileAvatarUploadViewModel
@{
    ViewData["Title"] = "Profile avatar";
    string? currentAvatarUrl = ViewData["CurrentAvatarUrl"] as string;
}
<h1>Profile avatar</h1>
@if (currentAvatarUrl is not null)
{
    <p><img class="avatar-preview" src="@currentAvatarUrl" alt="Current avatar" data-testid="current-avatar" /></p>
}
@* enctype multipart/form-data is required for IFormFile binding. *@
<form asp-action="Index" method="post" enctype="multipart/form-data" novalidate>
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <div class="form-field">
        <label asp-for="AvatarImageFile"></label>
        <input asp-for="AvatarImageFile" type="file" accept=".png,.jpg,.jpeg,.gif,.webp" data-testid="avatar-file-input" />
        <span asp-validation-for="AvatarImageFile" class="field-error" data-testid="avatar-file-error"></span>
    </div>
    <button type="submit">Upload avatar</button>
</form>
