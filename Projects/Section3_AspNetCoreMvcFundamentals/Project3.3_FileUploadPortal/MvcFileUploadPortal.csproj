<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>MvcFileUploadPortal</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Uploaded files are runtime data, never part of the published build output. -->
    <Content Remove="wwwroot/uploads/**" />
    <None Include="wwwroot/uploads/**/.gitkeep" />
  </ItemGroup>
</Project>
