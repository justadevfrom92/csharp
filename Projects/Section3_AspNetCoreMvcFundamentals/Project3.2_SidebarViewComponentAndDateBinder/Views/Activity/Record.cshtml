@model RecordActivityFormViewModel
@{ ViewData["Title"] = "Record activity"; }
<h1>Record activity</h1>
<form asp-action="Record" method="post" novalidate>
    <div class="form-field"><label asp-for="ActorDisplayName"></label><input asp-for="ActorDisplayName" /><span asp-validation-for="ActorDisplayName" class="field-error"></span></div>
    <div class="form-field"><label asp-for="Kind"></label>
        <select asp-for="Kind" asp-items="Html.GetEnumSelectList<ActivityKind>()"><option value="">-- choose --</option></select>
        <span asp-validation-for="Kind" class="field-error"></span></div>
    <div class="form-field"><label asp-for="ActivityDescription"></label><input asp-for="ActivityDescription" /><span asp-validation-for="ActivityDescription" class="field-error"></span></div>
    <button type="submit">Record</button>
</form>
