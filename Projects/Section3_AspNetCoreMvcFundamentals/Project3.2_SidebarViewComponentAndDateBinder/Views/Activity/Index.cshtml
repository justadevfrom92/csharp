@model ActivityReportPageViewModel
@{ ViewData["Title"] = "Activity report"; }
<h1>Activity report</h1>
<form method="get" class="filter-bar">
    <label>From <input name="from" placeholder="yyyy-MM-dd" value="@(Context.Request.Query["from"])" data-testid="from-date-input" /></label>
    <label>To <input name="to" placeholder="yyyy-MM-dd" value="@(Context.Request.Query["to"])" data-testid="to-date-input" /></label>
    <select name="kind" asp-items="Html.GetEnumSelectList<ActivityKind>()"><option value="">Any kind</option></select>
    <button type="submit">Apply</button>
</form>
@if (Model.QueryValidationErrors.Count > 0)
{
    <div class="alert alert-danger" data-testid="query-validation-errors">
        <ul>@foreach (string error in Model.QueryValidationErrors) { <li>@error</li> }</ul>
    </div>
}
else
{
    <p class="muted">Bound range: @(Model.AppliedQuery.InclusiveStartDate?.ToString("yyyy-MM-dd") ?? "(open)") → @(Model.AppliedQuery.InclusiveEndDate?.ToString("yyyy-MM-dd") ?? "(open)"),
        kind: @(Model.AppliedQuery.KindFilter?.ToString() ?? "any") — <span data-testid="match-count">@Model.MatchingEntries.Count</span> match(es)</p>
    <table class="data-table">
        <thead><tr><th>When (UTC)</th><th>Kind</th><th>Actor</th><th>Description</th></tr></thead>
        <tbody>
        @foreach (RecentActivityEntry entry in Model.MatchingEntries)
        {
            <tr><td>@entry.OccurredAt.ToString("yyyy-MM-dd HH:mm")</td><td>@entry.Kind</td><td>@entry.ActorDisplayName</td><td>@entry.ActivityDescription</td></tr>
        }
        </tbody>
    </table>
}
